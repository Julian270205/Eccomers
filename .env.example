# =============================================================
# Jhoana Rosales Boutique - Variables de Entorno
# Copiar este archivo a .env y completar los valores
# NUNCA subir .env a Git
# =============================================================

# Entorno
NODE_ENV=development
PORT=3000

# Base de datos MySQL
# Local:       mysql://root:password@localhost:3306/jhoana_boutique
# PlanetScale: mysql://user:pass@host.psdb.cloud/jhoana_boutique?sslaccept=strict
# AWS RDS:     mysql://admin:pass@host.rds.amazonaws.com:3306/jhoana_boutique
DATABASE_URL="mysql://root:password@localhost:3306/jhoana_boutique"
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=jhoana_boutique

# Sesiones (usar cadena aleatoria larga en producción — mínimo 32 caracteres)
SESSION_SECRET=cambiar_por_secreto_muy_largo_y_aleatorio_en_produccion
SESSION_MAX_AGE=86400000

# WhatsApp (número sin + ni espacios)
WHATSAPP_NUMBER=573024246026

# URL base (sin slash al final)
APP_BASE_URL=http://localhost:3000

# Cloudinary — imágenes de productos (requerido en Vercel/producción)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Wompi — pagos en línea (opcional)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# Upload local (solo para desarrollo)
UPLOAD_PATH=./public/images/products
MAX_FILE_SIZE=5242880

# Seguridad
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
